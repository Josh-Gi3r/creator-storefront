# ──────────────────────────────────────────────────────────────────────────────
# Creator Storefront — environment variables
# Copy to .env and fill in your values. Never commit .env to source control.
# Only DATABASE_URL, JWT_SECRET, VITE_APP_ID and OAUTH_SERVER_URL are required;
# every other block is optional and stays off until you fill it in.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server binds to (API + client). Auto-increments if busy.
PORT=3000

# ── Database (required) ───────────────────────────────────────────────────────
# MySQL connection string (mysql2 driver format).
# Example: mysql://user:password@host:3306/dbname
DATABASE_URL=mysql://user:password@localhost:3306/creator_storefront

# ── Session / Auth (required) ─────────────────────────────────────────────────
# >=32-char random secret used to sign session cookies. The server throws on
# boot if this is missing or shorter than 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters_here

# OAuth application / client ID (from your OIDC provider dashboard).
VITE_APP_ID=your-oauth-client-id

# Base URL of your OIDC provider (e.g. https://auth.example.com).
OAUTH_SERVER_URL=https://auth.example.com

# Optional: client-side login portal URL the frontend redirects users to.
# Leave blank to fall back to the default sign-in route.
VITE_OAUTH_PORTAL_URL=

# ── Platform owner (optional) ─────────────────────────────────────────────────
# The openId of the user who should automatically receive the admin role.
# Leave blank to skip auto-admin assignment.
OWNER_OPEN_ID=

# ── LLM (optional) ────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat endpoint + key. Leave blank to disable AI features.
# Also used as the fallback proxy for storage and maps when their own vars are
# unset (see below).
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...

# ── Data / media proxy (optional) ─────────────────────────────────────────────
# Server-side data/media proxy used by server/_core/dataApi.ts and
# server/_core/voiceTranscription.ts. Leave blank to disable external data
# lookups and voice transcription.
DATA_PROXY_URL=
DATA_PROXY_KEY=

# Client-side proxy used by the Map component (client/src/components/Map.tsx).
# Only needed if you enable the map / location features in the browser.
VITE_MAPS_PROXY_URL=
VITE_MAPS_PROXY_KEY=

# ── File storage (optional) ───────────────────────────────────────────────────
# Default storage path (server/storage.ts) talks to an S3-compatible HTTP proxy.
# If unset, it falls back to LLM_API_BASE_URL / LLM_API_KEY above. Set these to
# point uploads at a dedicated storage proxy.
STORAGE_BASE_URL=
STORAGE_API_KEY=

# Direct object storage — ONLY needed if you swap server/adapters/storage for
# the AWS S3 / R2 adapter (see server/adapters/storage/interface.ts). Ignored by
# the default proxy storage path above.
STORAGE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Maps / location (optional) ────────────────────────────────────────────────
# Server-side maps proxy used by server/_core/map.ts. If unset, falls back to
# LLM_API_BASE_URL / LLM_API_KEY. Leave blank to disable location features.
MAPS_API_BASE_URL=
MAPS_API_KEY=

# ── Notifications (optional) ──────────────────────────────────────────────────
# Webhook (Slack/Discord/etc.) for server notifications (server/_core/notification.ts).
# Leave blank for a silent no-op.
# Example: https://hooks.slack.com/services/T.../B.../...
NOTIFICATION_WEBHOOK_URL=
